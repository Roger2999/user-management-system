# Variables de entorno — plantilla
#
# Copiá este archivo a `.env` y completá los valores:
#   cp .env.example .env
#
# `.env` está en .gitignore y nunca se versiona. Este template sí.

# ─────────────────────────────────────────────────────────────
# Base de datos (obligatoria)
# ─────────────────────────────────────────────────────────────

# Connection string de PostgreSQL. Es la única que Prisma necesita para
# `prisma generate`, así que el build de producción no se rompe sin ella.
DATABASE_URL="postgresql://usuario:password@localhost:5432/nombre_db?schema=public"

# Connection string de Prisma Accelerate, si lo usás.
CONNECTION_STRING_ACCELERATE=""

# ─────────────────────────────────────────────────────────────
# Better Auth (obligatorias)
# ─────────────────────────────────────────────────────────────

# Secreto de firma de sesiones. Generalo con:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# URL base del servidor.
BETTER_AUTH_URL="http://localhost:3000"

# URL base para el cliente. Opcional: si no está, cae a localhost.
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# GitHub OAuth (opcionales — sólo para login social)
# ─────────────────────────────────────────────────────────────

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────
# Emails (opcional)
# ─────────────────────────────────────────────────────────────

# Clave de Resend. Sin una clave válida, el envío de emails de recuperación
# falla y queda registrado en el log del servidor (la app sigue funcionando).
RESEND_API_KEY=""

# ─────────────────────────────────────────────────────────────
# Administrador inicial (opcional)
# ─────────────────────────────────────────────────────────────

# `pnpm db:seed` crea este usuario SOLO si la tabla `user` está vacía.
# Cambiá la contraseña desde Configuración después del primer login.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin"
SEED_ADMIN_EMAIL="admin@localhost"
SEED_ADMIN_FULLNAME="Administrador"
SEED_ADMIN_POSITION="Administrador"
