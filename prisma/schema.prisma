// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

model User {
  id                   String                    @id
  name                 String
  username             String?                   @unique @db.Citext
  displayUsername      String?
  email                String
  emailVerified        Boolean                   @default(false)
  image                String?
  role                 UserRole                  @default(USER)
  position             String
  fullName             String
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  sessions             Session[]
  accounts             Account[]
  registeredSignatures AccountRequestSignature[]
  createdRequests      AccountRequest[]           @relation("AccountRequestCreatedBy")
  updatedRequests      AccountRequest[]           @relation("AccountRequestUpdatedBy")
  auditLogs            AuditLog[]
  importedLogFiles     ImportedLogFile[]         @relation("LogFileImportedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum UserRole {
  USER
  ADMIN
}

enum RequestType {
  NEW
  UPDATE
  DEPROVISIONING
}

enum StaffType {
  EXECUTIVE
  SENIOR_SPECIALIST
  TECHNICIAN
  OTHER
}

enum AccountType {
  PERMANENT
  TEMPORARY
}

enum AccountRequestStage {
  requested
  revised
  approved
  executed
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SIGN
}

model AccountRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByUserId String?
  createdByUser   User?   @relation("AccountRequestCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?
  updatedByUser   User?   @relation("AccountRequestUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  // Header
  folio       String?     @unique @db.Citext
  requestType RequestType

  // Deprovisioning
  deprovisioningReasons String?
  deprovisionedAt       DateTime?

  // Personal details
  fullName        String
  phoneExtension  String?   @unique @db.Citext
  currentPosition String
  department      String
  staffType       StaffType
  username        String?   @unique @db.Citext

  // Email
  nationalEmail      Boolean @default(false)
  internationalEmail Boolean @default(false)
  internetEmail      Boolean @default(false)

  // Web browsing
  intranetUNE      Boolean @default(false)
  nationalIntranet Boolean @default(false)
  internet         Boolean @default(false)

  // Corporate messaging
  corporateMessaging Boolean @default(false)

  // Social media
  facebook      Boolean @default(false)
  twitter       Boolean @default(false)
  youtube       Boolean @default(false)
  whatsapp      Boolean @default(false)
  telegram      Boolean @default(false)
  instagram     Boolean @default(false)
  otherNetworks String?

  // Privileges
  userAccount         Boolean @default(false)
  advancedUserAccount Boolean @default(false)
  localAdmin          Boolean @default(false)
  networkAdmin        Boolean @default(false)

  // UNE cloud access
  cloudAccessRead        Boolean @default(false)
  cloudAccessModify      Boolean @default(false)
  cloudAccessDelete      Boolean @default(false)
  cloudAccessFullControl Boolean @default(false)

  // Account type
  accountType AccountType
  expiresAt   DateTime?

  // Schedules
  overtimeSchedule       Boolean @default(false)
  aroundTheClockSchedule Boolean @default(false)
  overtimeFrom           String?
  overtimeTo             String?
  saturdayFrom           String?
  saturdayTo             String?
  sundayFrom             String?
  sundayTo               String?

  // APN
  apnNationalEmail      Boolean @default(false)
  apnInternationalEmail Boolean @default(false)
  apnInternet           Boolean @default(false)
  mobilePhone           String? @unique @db.Citext

  // Authorized PC
  pcName               String? @unique @db.Citext
  pcAssetTag           String? @unique @db.Citext
  additionalPcName     String? @unique @db.Citext
  additionalPcAssetTag String? @unique @db.Citext

  // Software
  authorizedSoftware String?

  // User account
  //cuentaUsuario        String?
  //actividadRealiza     String?
  //administradorSistema Boolean @default(false)

  // Signatures
  signatures AccountRequestSignature[]
}

model AccountRequestSignature {
  id                 String              @id @default(cuid())
  accountRequestId   String
  accountRequest     AccountRequest      @relation(fields: [accountRequestId], references: [id], onDelete: Cascade)
  stage              AccountRequestStage
  fullName           String
  position           String
  signedAt           DateTime            @default(now())
  registeredByUserId String?
  registeredByUser   User?               @relation(fields: [registeredByUserId], references: [id], onDelete: SetNull)
  registeredByName   String?
  correctionHistory  Json?

  @@unique([accountRequestId, stage])
  @@index([accountRequestId])
  @@index([registeredByUserId])
}

/// Registro de auditoria de bajo nivel: quien hizo que, sobre que entidad y
/// cuando. Se escribe en crear, editar, borrar y firmar solicitudes.
model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entityType  String
  entityId    String
  actorUserId String?
  actorUser   User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName   String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Informe mensual de trazas de navegación (Squid)
// ─────────────────────────────────────────────────────────────

enum RuleCategory {
  ADULT
  SUBVERSIVE
  ANON_PROXY
  MINING
}

enum RuleMatchType {
  DOMAIN
  SUFFIX
  CONTAINS
}

enum ReportStatus {
  DRAFT
  REVIEW
  APPROVED
  EXPORTED
}

enum FindingDisposition {
  PENDING
  CONFIRMED
  FALSE_POSITIVE
  ACTION_TAKEN
}

/// Cuenta con la que el usuario se autentica en el proxy contra el AD.
/// Una cuenta = una persona (política de la empresa). El registro aporta el
/// nombre y el cargo que el informe necesita para la tabla de incidencias.
model ProxyAccount {
  username    String   @id
  displayName String?
  position    String?
  area        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dailyUserStats DailyUserStat[]
  dailySiteUsers DailySiteUserStat[]
  findings       ReportFinding[]

  @@map("proxy_account")
}

/// Archivo diario de logs importado. El sha256 es la clave de idempotencia:
/// reimportar el mismo archivo no duplica datos.
model ImportedLogFile {
  id           String   @id @default(cuid())
  sha256       String   @unique
  fileName     String
  sizeBytes    BigInt
  linesTotal   Int
  linesInvalid Int
  firstEventAt DateTime
  lastEventAt  DateTime
  importedAt   DateTime @default(now())

  importedById String?
  importedBy   User?    @relation("LogFileImportedBy", fields: [importedById], references: [id], onDelete: SetNull)

  @@index([firstEventAt, lastEventAt])
  @@map("imported_log_file")
}

/// Líneas descartadas por día, por motivo. Se suman entre archivos: un día
/// local puede venir repartido en dos archivos UTC.
model DailySkipped {
  date      DateTime @db.Date @id
  unserved  Int      @default(0)
  internal  Int      @default(0)
  telemetry Int      @default(0)

  @@map("daily_skipped")
}

/// Totales del día local por cuenta. Es la base de la tabla
/// "Los 10 usuarios que más descargaron".
model DailyUserStat {
  date           DateTime     @db.Date
  proxyAccountId String
  proxyAccount   ProxyAccount @relation(fields: [proxyAccountId], references: [username], onDelete: Cascade)
  hits           Int
  bytesIn        BigInt
  bytesOut       BigInt
  elapsedMs      BigInt
  browsingMs     BigInt

  @@id([date, proxyAccountId])
  @@map("daily_user_stat")
}

/// Totales del día local por sitio. Es la base de la tabla de sitios más
/// visitados y de la separación nacional / internacional.
///
/// La telemetría también se escribe acá, marcada con `isTelemetry`: sus hits
/// cuentan en los totales del informe (son respuestas servidas, y son el
/// denominador real de `% of Hits`), pero no compiten en las tablas de sitios.
/// Se persiste el veredicto, no el patrón: cambiar la lista de telemetría exige
/// reimportar para que los totales y la marca sigan describiendo el mismo dato.
model DailySiteStat {
  date        DateTime @db.Date
  site        String
  hits        Int
  bytesIn     BigInt
  bytesOut    BigInt
  elapsedMs   BigInt
  browsingMs  BigInt
  isTelemetry Boolean  @default(false)

  @@id([date, site])
  @@map("daily_site_stat")
}

/// Cruce sitio × cuenta de un día. Se persisten **todos** los pares de todos los
/// sitios (S17): el recorte a diez filas es del render, nunca del almacenamiento.
/// Truncar acá rompería el denominador del `% of Browsing Time` del drill-down
/// (S15), que se calcula sobre la suma de los usuarios del sitio.
///
/// El costo en filas es real y no está medido: no se diseña alrededor de una
/// estimación. Si la primera importación real muestra que la tabla es inmanejable,
/// la salida es persistir solo el top diario y verificar la cobertura al cierre del
/// mes, nunca truncar el denominador.
///
/// El tráfico sin cuenta no entra: `proxyAccountId` es una clave foránea a
/// `ProxyAccount` y S9 prohíbe inventar una cuenta. Esos hits siguen en
/// `DailySiteStat` y se reconstruyen como la diferencia.
model DailySiteUserStat {
  date           DateTime     @db.Date
  site           String
  proxyAccountId String
  proxyAccount   ProxyAccount @relation(fields: [proxyAccountId], references: [username], onDelete: Cascade)
  hits           Int
  bytesIn        BigInt
  elapsedMs      BigInt
  browsingMs     BigInt

  @@id([date, site, proxyAccountId])
  @@index([date, hits])
  @@map("daily_site_user_stat")
}

/// Regla de detección de una categoría prohibida del informe. Versionada:
/// el informe emitido cita la versión con la que se evaluó.
model CategoryRule {
  id        String        @id @default(cuid())
  category  RuleCategory
  matchType RuleMatchType
  pattern   String
  active    Boolean       @default(true)
  version   Int           @default(1)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  findings ReportFinding[]

  @@unique([category, matchType, pattern])
  @@map("category_rule")
}

/// El documento del mes. Los totales se congelan en `snapshot` al aprobar:
/// reimportar un archivo corregido después no altera un informe ya emitido.
model MonthlyReport {
  id                   String       @id @default(cuid())
  year                 Int
  month                Int
  status               ReportStatus @default(DRAFT)

  rulesetVersion       Int
  coverageDaysExpected Int
  coverageDaysImported Int
  totalHits            BigInt
  unidentifiedHits     BigInt

  templateVersion      Int
  motto                String?
  place                String?
  issuedOn             DateTime?
  docxSha256           String?
  pdfSha256            String?

  snapshot             Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  findings ReportFinding[]

  @@unique([year, month])
  @@map("monthly_report")
}

/// Coincidencia de una regla con tráfico real. La disposición y la medida son
/// las que terminan en las columnas del documento.
model ReportFinding {
  id              String             @id @default(cuid())
  monthlyReportId String
  monthlyReport   MonthlyReport      @relation(fields: [monthlyReportId], references: [id], onDelete: Cascade)
  categoryRuleId  String
  categoryRule    CategoryRule       @relation(fields: [categoryRuleId], references: [id])
  proxyAccountId  String?
  proxyAccount    ProxyAccount?      @relation(fields: [proxyAccountId], references: [username], onDelete: SetNull)

  url         String
  hits        Int
  firstSeen   DateTime
  lastSeen    DateTime
  disposition FindingDisposition @default(PENDING)
  measure     String?
  createdAt   DateTime           @default(now())

  @@index([monthlyReportId])
  @@map("report_finding")
}
