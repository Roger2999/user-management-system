// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum TipoSolicitud {
  ALTA
  ACTUALIZACION
  BAJA
}


enum TipoPersonal {
  DIRECTIVO
  ESPECIALISTA_PRINCIPAL
  TECNICO
  OTRO
}

enum TipoCuenta {
  PERMANENTE
  TEMPORAL
}

model AccountRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Encabezado
  folio         String?   @unique @db.Citext
  tipoSolicitud TipoSolicitud

  // Baja
  motivosBaja String?
  fechaBaja   DateTime?

  // Datos personales
  nombreApellidos   String
  telefonoExtension String? @unique @db.Citext
  cargoOcupa        String
  departamentoArea  String
  tipoPersonal      TipoPersonal
  identificadorCuentaUsuario String? @unique @db.Citext

  // Correo electrónico
  correoNacional      Boolean @default(false)
  correoInternacional Boolean @default(false)
  correoInternet      Boolean @default(false)

  // Navegación web
  intranetUNE      Boolean @default(false)
  intranetNacional Boolean @default(false)
  internet         Boolean @default(false)

  // Mensajería
  mensajeriaCorporativa Boolean @default(false)

  // Redes sociales
  facebook   Boolean @default(false)
  twitter    Boolean @default(false)
  youtube    Boolean @default(false)
  whatsapp   Boolean @default(false)
  telegram   Boolean @default(false)
  instagram  Boolean @default(false)
  otrasRedes String?

  // Privilegios
  usuario         Boolean @default(false)
  usuarioAvanzado Boolean @default(false)
  adminLocal      Boolean @default(false)
  adminRed        Boolean @default(false)

  // Acceso Nube UNE
  accesoNubeLectura      Boolean @default(false)
  accesoNubeModificar    Boolean @default(false)
  accesoNubeBorrar       Boolean @default(false)
  accesoNubeControlTotal Boolean @default(false)

  // Tipo de cuenta
  tipoCuenta      TipoCuenta
  fechaExpiracion DateTime?

  // Horarios
  horarioExtralaboral Boolean @default(false)
  horario24Horas      Boolean @default(false)
  extraDesde          String?
  extraHasta          String?
  sabadoDesde         String?
  sabadoHasta         String?
  domingoDesde        String?
  domingoHasta        String?

  // APN
  apnCorreoNacional      Boolean @default(false)
  apnCorreoInternacional Boolean @default(false)
  apnInternet            Boolean @default(false)
  telefonoCelular        String? @unique @db.Citext

  // PC autorizado
  pcNombre              String? @unique @db.Citext
  pcInventario          String? @unique @db.Citext
  pcAdicionalNombre     String? @unique @db.Citext
  pcAdicionalInventario String? @unique @db.Citext

  // Software
  softwareAutorizado String?

  // Cuenta de usuario
  //cuentaUsuario        String?
  //actividadRealiza     String?
  //administradorSistema Boolean @default(false)

  // Firmas — Solicitado
  firmadoPorSolicitado Boolean @default(false)
  solicitadoFecha      DateTime?
  //solicitadoNombre   String?
  //solicitadoCargo    String?

  // Firmas — Revisado
  firmadoPorRevisado Boolean @default(false)
  revisadoFecha      DateTime?
  //revisadoNombre    String?
  //revisadoCargo     String?

  // Firmas — Aprobado
  firmadoPorAprobado Boolean @default(false)
  aprobadoFecha      DateTime?
  //aprobadoNombre    String?
  //aprobadoCargo     String?

  // Firmas — Ejecutado
  firmadoPorEjecutado Boolean @default(false)
  ejecutadoFecha      DateTime?
  //ejecutadoNombre    String?
  //ejecutadoCargo     String?
}